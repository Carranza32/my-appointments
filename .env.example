# Supabase — Project Settings → Database
# Si la contraseña tiene , # @ etc., codifícala en la URL (encodeURIComponent).
#
# Runtime — session pooler (puerto 5432). Usa 6543 + ?pgbouncer=true en producción serverless si tu red lo permite.
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD_ENCODED]@aws-0-[REGION].pooler.supabase.com:5432/postgres"
# Migraciones Prisma — mismo session pooler :5432 (db.[REF].supabase.co a veces no responde en redes locales)
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[PASSWORD_ENCODED]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# Supabase Auth (Settings → API Keys)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."

# URL pública de la app (OAuth redirect)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Google OAuth (mismo Client ID/Secret que en Supabase → Google provider)
GOOGLE_CLIENT_ID="....apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-..."

# Zona horaria para eventos de Google Calendar
BUSINESS_TIMEZONE="America/Mexico_City"
